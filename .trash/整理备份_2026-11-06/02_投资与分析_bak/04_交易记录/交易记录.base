filters:
  and:
    - file.inFolder("02_投资与分析/04_交易记录")
    - 'file.ext == "md"'
    - 'file.name != "_交易记录模板"'
    - 'note.company != null'
    - 'note.action != null'

properties:
  company:
    displayName: 公司
  ticker:
    displayName: 代码
  action:
    displayName: 操作
  trade_date:
    displayName: 日期
  price:
    displayName: 价格
  shares:
    displayName: 数量
  amount:
    displayName: 金额
  position_pct:
    displayName: 仓位%
  ev_estimate:
    displayName: 预期EV%
  max_loss_pct:
    displayName: 可承受亏损%
  outcome:
    displayName: 结果

views:
  - type: table
    name: 全部交易
    order:
      - trade_date
      - company
      - action
      - price
      - shares
      - amount
      - position_pct
      - ev_estimate
      - max_loss_pct
      - outcome
    sort:
      - property: trade_date
        direction: DESC

  - type: table
    name: 持仓中
    filters:
      and:
        - 'outcome == "进行中"'
    order:
      - company
      - action
      - trade_date
      - amount
      - position_pct
      - ev_estimate
      - max_loss_pct
      - file.mtime
    sort:
      - property: trade_date
        direction: DESC

  - type: table
    name: 已了结
    filters:
      and:
        - 'outcome != "进行中"'
    order:
      - company
      - trade_date
      - amount
      - outcome
      - file.mtime
    sort:
      - property: trade_date
        direction: DESC
