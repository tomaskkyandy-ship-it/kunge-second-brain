filters:
  and:
    - file.inFolder("02_投资与分析/03_个股研究与股票池")
    - file.ext == "md"
    - file.name != "_选股分析模板"
    - file.name != "股票池"
    - file.name != "新物种与候选猎物雷达池"
    - !tags.contains("模板")
    - note.代码 != null
views:
  - type: table
    name: 我的股票池全景
    order:
      - 标的名称
      - 代码
      - 所属池子
      - 状态
      - 现价
      - 🟢学徒买点
      - 🔴师傅卖点
      - 当前仓位%
      - 目标仓位%
      - 💣排雷日历
      - 质量分%
      - 时机分%
      - 新物种生命力%
      - 综合分%
      - 结论
    sort:
      - property: 综合分%
        direction: DESC
  - type: table
    name: 💎皇冠明珠狙击池
    filters:
      and:
        - or:
            - 质量分% >= 75
            - 所属池子 == "💎皇冠明珠复利池"
    order:
      - 标的名称
      - 代码
      - 现价
      - 🟢学徒买点
      - 🔴师傅卖点
      - 质量分%
      - 时机分%
      - 综合分%
      - 当前仓位%
      - 目标仓位%
      - 💣排雷日历
      - 状态
      - 结论
    sort:
      - property: 质量分%
        direction: DESC
  - type: table
    name: 🚀新物种观察池
    filters:
      and:
        - or:
            - 新物种生命力% >= 80
            - 所属池子 == "🚀新物种观察池"
    order:
      - 标的名称
      - 代码
      - 现价
      - 🟢学徒买点
      - 🔴师傅卖点
      - 新物种生命力%
      - 质量分%
      - 综合分%
      - 当前仓位%
      - 目标仓位%
      - 💣排雷日历
      - 状态
      - 结论
    sort:
      - property: 新物种生命力%
        direction: DESC
  - type: table
    name: 股票标的
    filters:
      and:
        - 类型 == "股票"
    order:
      - 标的名称
      - 代码
      - 所属池子
      - 状态
      - 现价
      - 🟢学徒买点
      - 🔴师傅卖点
      - 质量分%
      - 时机分%
      - 综合分%
      - 当前仓位%
      - 目标仓位%
      - 💣排雷日历
      - 结论
    sort:
      - property: 综合分%
        direction: DESC
  - type: table
    name: 加密资产
    filters:
      and:
        - 类型 == "加密资产"
    order:
      - 标的名称
      - 代码
      - 所属池子
      - 状态
      - 现价
      - 🟢学徒买点
      - 🔴师傅卖点
      - 质量分%
      - 时机分%
      - 综合分%
      - 当前仓位%
      - 目标仓位%
      - 💣排雷日历
      - 结论
    sort:
      - property: 综合分%
        direction: DESC
  - type: cards
    name: 卡片视图
    order:
      - 标的名称
      - 所属池子
      - 现价
      - 🟢学徒买点
      - 🔴师傅卖点
      - 质量分%
      - 新物种生命力%
      - 综合分%
      - 💣排雷日历
      - 结论
    sort:
      - property: 综合分%
        direction: DESC
